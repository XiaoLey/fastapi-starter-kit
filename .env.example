# 开发入口；生产使用APP_ENV=production、APP_DEBUG=false及独立凭据/前缀
APP_NAME="FastAPI Starter"
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
APP_WORKERS=1
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8000
APP_API_PREFIX=/api
APP_QPS=10
APP_CORS_ORIGINS=[]
APP_CORS_ALLOW_CREDENTIALS=false
APP_TRUSTED_PROXY_IPS=

# 默认无认证；需要时按README显式选择模块
AUTH_MODULES=[]
AUTH_PASSWORD_IDENTIFIERS=["username"]
# 启用使用本地token的模块后，生成独立随机密钥再取消注释
# JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
JWT_TTL=30
JWT_ISSUER=fastapi-starter-kit
JWT_AUDIENCE=api

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fastapi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_POOL_SIZE=4
POSTGRES_MAX_OVERFLOW=4
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-a-redis-password
REDIS_KEY_PREFIX=fastapi

# phone/email注册或OTP登录需要独立密钥及对应sender factory
# AUTH_CODE_SECRET_KEY=replace-with-another-independent-random-secret
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_SEND_INTERVAL_SECONDS=60

LOG_LEVEL=INFO
LOG_FILE_WITH_HOSTNAME_PREFIX=false
# 显式设置才写文件；多worker建议stdout交由进程外收集
# LOG_PATH=storage/logs/[hostname]-fastapi-{time:YYYY-MM-DD}.log
LOG_RETENTION="14 days"
